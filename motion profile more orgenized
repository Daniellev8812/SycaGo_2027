def calculate_profile(max_velocety,target_distance,acceleration):
    max_v=abs(max_velocety)
    accel=abs(acceleration)
    target_d=abs(target_distance)
    speed_distance = (max_v ** 2) / (2 * accel)
    if target_d >= speed_distance * 2:
        deceleration_distance = (max_v ** 2) / (2 * accel)
        acceleration_distance = speed_distance
        deceleration_distance = speed_distance
        profile_speed = max_v
    else:
         half_distance = target_d / 2
        acceleration_distance = half_distance
        deceleration_distance = half_distance
        profile_speed = (2 * accel * half_distance) ** 0.5
    return (
       acceleration_distance
       deceleration_distance 
       profile_speed
    )
    
